# Where emailed links point (the React app)
APP_URL=http://localhost:5173

# SMTP (defaults to Gmail). For Gmail: enable 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Expense Tracker <yourname@gmail.com>"

# Secret used to sign login tokens (use a long random string)
JWT_SECRET=change-me
